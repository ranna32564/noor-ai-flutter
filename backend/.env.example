PORT=3000
API_ACCESS_TOKEN=generate_a_long_random_secret_for_app_authentication
# Set these on the server only. Never commit a real secret.
GEMINI_API_KEY=replace_with_your_server_side_key
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=replace_with_your_server_side_key
OPENROUTER_MODEL=openrouter/auto
DEFAULT_PROVIDER=gemini
PROVIDER_TIMEOUT_MS=45000
# Optional comma-separated allowed origins, e.g. https://your-app.example
CORS_ORIGIN=
